rules_version = '2';

/* 반 단위 다중 교사 체계.
 * - 교사: Firebase 인증(이메일)으로 로그인. 자기 반의 명단·설정만 쓸 수 있다.
 * - 학생: 로그인 없음. 반 코드를 알면 명단을 읽고 기록을 '추가만' 할 수 있다.
 * ⚠️ 학생 기록은 인증 없이 추가되므로 반 코드를 아는 사람은 기록을 읽거나
 *    위조 기록을 넣을 수 있다 (기존과 동일한 한계).
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(code) {
      return signedIn()
        && get(/databases/$(database)/documents/classes/$(code)).data.teacherUid == request.auth.uid;
    }

    function validResult() {
      let d = request.resource.data;
      return d.keys().hasAll(['studentNo', 'level', 'mode', 'correct', 'incorrect', 'durationSec', 'ts'])
        && d.keys().size() <= 20
        && d.studentNo is string && d.studentNo.size() <= 20
        && d.level is string && d.level.size() <= 8
        && d.mode is string && d.mode.size() <= 20
        && d.correct is number && d.correct >= 0 && d.correct <= 1000
        && d.incorrect is number && d.incorrect >= 0 && d.incorrect <= 1000
        && d.durationSec is number && d.durationSec >= 0
        && d.ts is number
        && (d.score == null || (d.score is number && d.score >= 0 && d.score <= 300));   // L36 만점 265
    }

    function validLog() {
      let d = request.resource.data;
      return d.keys().hasAll(['studentNo', 'ts'])
        && d.keys().size() <= 5
        && d.studentNo is string && d.studentNo.size() <= 20
        && d.ts is number;
    }

    // 랭킹용 최고점 요약 — 문서 ID = 학번.
    // 레벨 수가 줄어드는 덮어쓰기도 허용한다 (교사가 기록을 초기화한 뒤 학생 기기가 바른 값으로 고쳐 쓸 수 있도록).
    function validBest(id) {
      let d = request.resource.data;
      return d.keys().hasAll(['studentNo', 'best'])
        && d.keys().size() <= 4
        && d.studentNo is string && d.studentNo == id
        && d.best is map && d.best.size() <= 80
        && (!d.keys().hasAny(['lastTs']) || d.lastTs is number);
    }

    // 반 보스 설정 — 교사만 쓴다
    function validGame() {
      let d = request.resource.data;
      return d.keys().hasAll(['on', 'startTs', 'base'])
        && d.keys().size() <= 10
        && d.on is bool
        && d.startTs is number
        && d.base is number && d.base >= 0 && d.base <= 2000
        && (!d.keys().hasAny(['coefs']) || (d.coefs is list && d.coefs.size() <= 60))
        && (!d.keys().hasAny(['exclude']) || (d.exclude is list && d.exclude.size() <= 40));
    }

    // 반 보스·코인 요약 — 문서 ID = 학번. 학생 기기가 자기 기록으로 계산해 갱신한다(best 와 같은 방식).
    // earned·spent·boxes·items·equip·kills 는 코인·꾸미기 단계에서 쓸 자리 — 규칙을 다시 배포하지 않도록 미리 열어 둔다.
    function validWallet(id) {
      let d = request.resource.data;
      return d.keys().hasAll(['studentNo', 'dmg', 'startTs'])
        && d.keys().size() <= 12
        && d.studentNo is string && d.studentNo == id
        && d.dmg is number && d.dmg >= 0 && d.dmg <= 100000
        && d.startTs is number
        && (!d.keys().hasAny(['lastTs']) || d.lastTs is number)
        && (!d.keys().hasAny(['earned']) || (d.earned is number && d.earned >= 0 && d.earned <= 1000000))
        && (!d.keys().hasAny(['spent']) || (d.spent is number && d.spent >= 0 && d.spent <= 1000000))
        && (!d.keys().hasAny(['boxes']) || (d.boxes is number && d.boxes >= 0 && d.boxes <= 10000))
        && (!d.keys().hasAny(['items']) || (d.items is map && d.items.size() <= 80))
        && (!d.keys().hasAny(['equip']) || (d.equip is map && d.equip.size() <= 8))
        && (!d.keys().hasAny(['kills']) || (d.kills is list && d.kills.size() <= 200));
    }

    function validStudent() {
      let d = request.resource.data;
      return d.keys().hasAll(['number', 'name'])
        && d.keys().size() <= 5
        && d.number is string && d.number.size() >= 1 && d.number.size() <= 20
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40;
    }

    function validClass() {
      let d = request.resource.data;
      return d.keys().hasAll(['teacherUid', 'name'])
        && d.keys().size() <= 6
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        // 등교 안 하는 날 목록 (YYYY-MM-DD 문자열 배열, 최대 200개)
        && (!d.keys().hasAny(['offDays']) || (d.offDays is list && d.offDays.size() <= 200));
    }

    // 교사 프로필 — 본인만
    match /teachers/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 반 — 만들 때는 본인을 담당으로, 고칠 때는 담당 교사만 (담당 이전 불가)
    match /classes/{code} {
      allow read: if true;
      allow create: if signedIn() && validClass()
        && request.resource.data.teacherUid == request.auth.uid;
      allow update: if signedIn() && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == resource.data.teacherUid && validClass();
      allow delete: if false;   // 삭제 대신 archived 플래그 사용

      // 학생 명단 — 읽기는 공개(반 코드가 곧 접근권), 쓰기는 담당 교사만
      match /students/{id} {
        allow read: if true;
        allow create, update: if isOwner(code) && validStudent();
        allow delete: if isOwner(code);
      }

      // 기록 — 추가는 누구나(검증 통과 시), 수정 불가, 삭제는 담당 교사만
      match /results/{id} {
        allow read: if true;
        allow create: if validResult();
        allow update: if false;
        allow delete: if isOwner(code);
      }

      // 랭킹용 최고점 요약 — 학생 기기가 자기 기록으로 계산해 갱신, 지우는 것은 담당 교사만
      match /best/{id} {
        allow read: if true;
        allow create, update: if validBest(id);
        allow delete: if isOwner(code);
      }

      // 반 보스 설정 — 읽기는 공개, 쓰기는 담당 교사만
      match /game/{id} {
        allow read: if true;
        allow create, update: if isOwner(code) && validGame();
        allow delete: if isOwner(code);
      }

      // 반 보스·코인 요약 — 학생 기기가 갱신, 지우는 것은 담당 교사만
      match /wallet/{id} {
        allow read: if true;
        allow create, update: if validWallet(id);
        allow delete: if isOwner(code);
      }

      // 접속 로그 — 추가만 가능, 지우는 것은 담당 교사만
      match /logs/{id} {
        allow read: if true;
        allow create: if validLog();
        allow update: if false;
        allow delete: if isOwner(code);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
