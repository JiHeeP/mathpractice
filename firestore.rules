rules_version = '2';

/* 인증 없이 쓰는 교실용 규칙.
 * - 읽기는 열려 있고, 기록은 '새로 추가'만 가능하며 수정·삭제는 막는다.
 * - 학생 명단과 설정은 교사가 Firebase 콘솔에서만 바꿀 수 있다.
 * ⚠️ 인증이 없으므로 URL을 아는 사람은 누구나 기록을 읽을 수 있다. (README 참고)
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function validResult() {
      let d = request.resource.data;
      return d.keys().hasAll(['studentNo', 'level', 'mode', 'correct', 'incorrect', 'durationSec', 'ts'])
        && d.keys().size() <= 20
        && d.studentNo is string && d.studentNo.size() <= 20
        && d.level is string && d.level.size() <= 8
        && d.mode is string && d.mode.size() <= 20
        && d.correct is number && d.correct >= 0 && d.correct <= 1000
        && d.incorrect is number && d.incorrect >= 0 && d.incorrect <= 1000
        && d.durationSec is number && d.durationSec >= 0
        && d.ts is number
        && (d.score == null || (d.score is number && d.score >= 0 && d.score <= 200));
    }

    function validLog() {
      let d = request.resource.data;
      return d.keys().hasAll(['studentNo', 'ts'])
        && d.keys().size() <= 5
        && d.studentNo is string && d.studentNo.size() <= 20
        && d.ts is number;
    }

    // 학생 명단 — 앱은 읽기만, 수정은 콘솔에서
    match /students/{id} {
      allow read: if true;
      allow write: if false;
    }

    // 연습 결과 — 추가만 가능, 고치거나 지울 수 없음
    match /results/{id} {
      allow read: if true;
      allow create: if validResult();
      allow update, delete: if false;
    }

    // 접속 로그 — 추가만 가능
    match /accessLogs/{id} {
      allow read: if true;
      allow create: if validLog();
      allow update, delete: if false;
    }

    // 앱 설정(교사 PIN 해시 등)
    match /config/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
