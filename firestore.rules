rules_version = '2';

/* 반 단위 다중 교사 체계.
 * - 교사: Firebase 인증(이메일)으로 로그인. 자기 반의 명단·설정만 쓸 수 있다.
 * - 학생: 로그인 없음. 반 코드를 알면 명단을 읽고 기록을 '추가만' 할 수 있다.
 * ⚠️ 학생 기록은 인증 없이 추가되므로 반 코드를 아는 사람은 기록을 읽거나
 *    위조 기록을 넣을 수 있다 (기존과 동일한 한계).
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(code) {
      return signedIn()
        && get(/databases/$(database)/documents/classes/$(code)).data.teacherUid == request.auth.uid;
    }

    function validResult() {
      let d = request.resource.data;
      return d.keys().hasAll(['studentNo', 'level', 'mode', 'correct', 'incorrect', 'durationSec', 'ts'])
        && d.keys().size() <= 20
        && d.studentNo is string && d.studentNo.size() <= 20
        && d.level is string && d.level.size() <= 8
        && d.mode is string && d.mode.size() <= 20
        && d.correct is number && d.correct >= 0 && d.correct <= 1000
        && d.incorrect is number && d.incorrect >= 0 && d.incorrect <= 1000
        && d.durationSec is number && d.durationSec >= 0
        && d.ts is number
        && (d.score == null || (d.score is number && d.score >= 0 && d.score <= 200));
    }

    function validLog() {
      let d = request.resource.data;
      return d.keys().hasAll(['studentNo', 'ts'])
        && d.keys().size() <= 5
        && d.studentNo is string && d.studentNo.size() <= 20
        && d.ts is number;
    }

    function validStudent() {
      let d = request.resource.data;
      return d.keys().hasAll(['number', 'name'])
        && d.keys().size() <= 5
        && d.number is string && d.number.size() >= 1 && d.number.size() <= 20
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40;
    }

    function validClass() {
      let d = request.resource.data;
      return d.keys().hasAll(['teacherUid', 'name'])
        && d.keys().size() <= 6
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60;
    }

    // 교사 프로필 — 본인만
    match /teachers/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 반 — 만들 때는 본인을 담당으로, 고칠 때는 담당 교사만 (담당 이전 불가)
    match /classes/{code} {
      allow read: if true;
      allow create: if signedIn() && validClass()
        && request.resource.data.teacherUid == request.auth.uid;
      allow update: if signedIn() && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == resource.data.teacherUid && validClass();
      allow delete: if false;   // 삭제 대신 archived 플래그 사용

      // 학생 명단 — 읽기는 공개(반 코드가 곧 접근권), 쓰기는 담당 교사만
      match /students/{id} {
        allow read: if true;
        allow create, update: if isOwner(code) && validStudent();
        allow delete: if isOwner(code);
      }

      // 기록 — 추가는 누구나(검증 통과 시), 수정 불가, 삭제는 담당 교사만
      match /results/{id} {
        allow read: if true;
        allow create: if validResult();
        allow update: if false;
        allow delete: if isOwner(code);
      }

      // 접속 로그 — 추가만 가능, 지우는 것은 담당 교사만
      match /logs/{id} {
        allow read: if true;
        allow create: if validLog();
        allow update: if false;
        allow delete: if isOwner(code);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
